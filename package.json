{
	"name": "fe-hbs-starter",
	"version": "4.6.0",
	"type": "module",
	"description": "Front-end HBS Starter",
	"author": "Front-end",
	"private": true,
	"scripts": {
		"build-dev": "node ./node_scripts/tasks/build-dev",
		"build-prod": "node ./node_scripts/tasks/build-prod",
		"build-stage": "node ./node_scripts/tasks/build-stage",
		"cf": "node ./node_scripts/tasks/createFile",
		"assets": "node ./node_scripts/tasks/assets",
		"watch": "node ./node_scripts/tasks/watch",
		"add-lng": "node ./node_scripts/tasks/add-lng",
		"config-eslint": "eslint ./**/*.js --ignore-pattern dist --fix",
		"eslint": "eslint ./src/**/*.js",
		"server": "cd ../wwwroot && reload -b -p 3000",
		"prepare": "cd .. && husky Starter/.husky",
		"html-validate": "node ./node_scripts/tasks/html-validate.mjs"
	},
	"browserslist": [
		"last 2 versions",
		"ios >= 14"
	],
	"dependencies": {
		"@splidejs/splide": "^4.1.4"
	},
	"devDependencies": {
		"@babel/core": "7.28.6",
		"@babel/eslint-parser": "^7.28.6",
		"@babel/preset-env": "7.28.6",
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^9.39.2",
		"@vusion/webfonts-generator": "^0.8.0",
		"autoprefixer": "10.4.23",
		"axe-core": "^4.11.1",
		"babel-loader": "10.0.0",
		"chokidar": "5.0.0",
		"eslint": "9.39.2",
		"eslint-webpack-plugin": "^5.0.2",
		"fs-extra": "11.3.3",
		"globals": "^17.0.0",
		"handlebars": "4.7.8",
		"husky": "^9.1.7",
		"js-beautify": "1.15.4",
		"lint-staged": "^16.2.7",
		"postcss": "^8.5.6",
		"postcss-flexbugs-fixes": "5.0.2",
		"postcss-sort-media-queries": "^5.2.0",
		"sass": "1.97.3",
		"stylelint": "^17.0.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"svgo": "4.0.0",
		"w3c-html-validator": "^2.2.0",
		"webpack": "5.104.1",
		"webpack-cli": "6.0.1",
		"webpack-stream": "7.0.0",
		"yargs": "18.0.0"
	},
	"engines": {
		"node": ">=24.13.0"
	}
}