<section class="banner">
	<div class="wrap">
		<div class="banner__holder">
			<div class="banner__content">
				{{#if title}}
				<h2 class="banner__title">{{title}}</h2>
				{{/if}}
				{{#if subtitle}}
				<h2 class="banner__subtitle">{{subtitle}}</h2>
				{{/if}}
			</div>
			{{#if image}}
			{{> picture this}}
			{{/if}}
		</div>
	</div>
</section>