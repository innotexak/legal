<section class="basic-block{{#ifContains background "#000" "#024"}} basic-block--dark{{/ifContains}}" style="--bkg: {{background}}">
	<div class="wrap">
		<div class="basic-block__flex{{#if imageRight}} basic-block__flex--revert{{/if}}
			{{#ifAny title text link}} basic-block__flex--double{{else}} basic-block__flex--single{{/ifAny}}">
			{{#if image}}
			<div class="basic-block__col">
				<img class="basic-block__img" src="{{image.url}}" alt="{{image.alternateText}}">
			</div>
			{{/if}}
			{{#ifAny title text link}}
			<div class="basic-block__col">
				{{#if title}}
				<h2 class="basic-block__title h3">{{title}}</h2>
				{{/if}}
				{{#if text}}
				<p class="basic-block__text text">{{text}}</p>
				{{/if}}
				{{#if link}}
				{{> link this}}
				{{/if}}
			</div>
			{{/ifAny}}
		</div>
	</div>
</section>
