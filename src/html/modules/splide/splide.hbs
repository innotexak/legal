<section class="slider"{{#if (compare cards.length ">" 1)}} data-script="slider"{{/if}}>
	<div class="wrap">
		{{#if cards}}
		<!-- Slider main container -->
		<div class="splide{{#if (compare cards.length ">" 1)}} js-slider{{/if}}">
			<div class="splide__track">
				<!-- Additional required wrapper -->
				<div class="splide__list">
					<!-- Slides -->
					{{#each cards}}
					<div class="splide__slide">
						{{> card this}}
					</div>
					{{/each}}
				</div>
			</div>
			{{#if (compare cards.length ">" 1)}}
			<!-- If we need navigation buttons -->
			<div class="splide__arrows">
				<button type="button" class="splide__arrow splide__arrow--prev">
					<span class="sr-only">Previous slide</span>
					<span class="icon font-ico-chevron-prev" aria-hidden="true"></span>
				</button>
				<button type="button" class="splide__arrow splide__arrow--next">
					<span class="sr-only">Next slide</span>
					<span class="icon font-ico-chevron-next" aria-hidden="true"></span>
				</button>
			</div>
			<!-- If we need pagination -->
			<div class="splide__pagination"></div>
			{{/if}}
		</div>
		{{/if}}
	</div>
</section>