<div class="wrap">
	<div class="separator"></div>
</div>
<section class="s-table">
	<div class="wrap">
			<div class="s-table__container">
				{{#if serviceTable.items}}
				{{#each serviceTable.items}}
					<div class="s-table__card" style="background-color: {{this.color}};">
  						<div class="s-table__card-header" style="--card-color: {{this.color}};">
							<h1 class="s-table__heading">
								{{this.title}}
							</h1>
							<div class="row-one"></div>
							<div class="row-two"></div>
						</div>
						<ul class="s-table__card-body">
							{{#each this.services}}
							<li class="s-table__item">
								{{this}}
							</li>
							{{/each}}
						</ul>
						<div class="s-table__card-footer">
							<span class="s-table__percent">
								{{this.percent}}
							</span>
						</div>
					</div>
				{{/each}}
				{{/if}}
			</div>
	</div>
</section>
