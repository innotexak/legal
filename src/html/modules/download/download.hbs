<section class="download" id="download">
	<div class="wrap">
		{{#if download}}
		<div class="download__container" aria-labelledby="download-heading">
			<div class="download__content">
				<h1 class="download__heading" id="download-heading">{{download.heading}}</h1>
				{{#if download.fullReport}}
					<h2 class="download__subheading">{{download.fullReport.subHeading}}</h2>
					<div class="download__card">
						<a class="download__card-body" href="#" download aria-label="Download full report: {{download.fullReport.title}} ({{download.fullReport.file.ext}}, {{download.fullReport.file.size}} {{download.fullReport.file.unit}})">
							<img src="{{download.fullReport.icon.src}}" alt="" aria-hidden="true">
							<p class="download__card-text" role="presentation">
								<span>{{download.fullReport.title}}</span>
								<strong class="faint-text">
									<span class="uppercase">{{download.fullReport.file.ext}}</span>{{download.fullReport.file.size}}{{download.fullReport.file.unit}}
								</strong>
							</p>
						</a>
					</div>		
				{{/if}}


				{{#if download.chapter}}
					<h3 class="download__subheading">{{download.chapter.subHeading}}</h3>
					<ul class="content__list">

						{{#each download.chapter.items}}
							<li class="download__card" download aria-label="Download by chapter: {{this.title}} ({{this.file.ext}}, {{this.file.size}} {{this.file.unit}})">
								<a href="#" class="download__card-body">
									<img src="{{../download.fullReport.icon.src}}" alt="" aria-hidden="true">
									<p class="download__card-text" role="presentation">
										<span>{{this.title}}</span>
										<strong class="faint-text"> <span class="uppercase">{{this.file.ext}}</span>{{this.file.size}}{{this.file.unit}}</strong>
									</p>
								</a>
							</li>
						{{/each}}
					</ul>
				{{/if}}
			</div>
			{{#if download.image}}
				<div class="download__media">
					<img src="{{download.image.src}}" alt="{{download.image.alternativeText}}" class="media-image">
				</div>
			{{/if}}
		</div>
		{{/if}}

	</div>
</section>
