{{#if vision}}
<section class="vision" data-script="vision" id="vission">
    <div class="splide js-vision-splide" aria-label="Vision Slider">
        <div class="splide__track">
            <ul class="splide__list">
                {{#each vision.slides}}
                <li class="splide__slide vision__slide" style="background-image: url('{{this.background}}')" data-animate-direction="right">
                    <div class="wrap">
                        <div class="vision__content">
                            <h2 class="vision__title">{{this.title}}</h2>
                            <p class="vision__text js-vision__text">{{this.content}}</p>
                        </div>
                    </div>
                </li>
                {{/each}}
            </ul>
        </div>

        <div class="vision__arrows">
            <button class="vision__arrow vision__arrow--prev js-vision-prev" aria-label="Previous slide">
                <img src="assets/images/arrow-left.png" alt="previous">
            </button>
            <button class="vision__arrow vision__arrow--next js-vision-next" aria-label="Next slide">
                <img src="assets/images/arrow-right.png" alt="next">
            </button>
        </div>

        <div class="vision__pagination js-vision-pagination"></div>
    </div>

    <p class="vision__text-mobile  js-vision__text-mobile"> </p>

</section>
{{/if}}