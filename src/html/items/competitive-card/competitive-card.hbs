<article class="competitive-card">
	<div class="wrap">
		<div class="competitive-card__container">
			<div class="competitive-card__media">
				<img src="{{item.image.src}}" alt="{{item.image.alternativeText}}" class="completitive-card__image">
			</div>

			<div class="competitive-card__content">
				<div class="competitive-card__header">
					<span class="competitive-card__serial">{{increment index}}.</span>
					<strong class="competitive-card__heading">{{item.title}}</strong>
				</div>
				<p class="competitive-card__paragraph"> 
					{{item.content}}
				</p>
			</div>
		</div>
	</div>
</article>
